{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "residual-deduction",
  "version": "0.1.0",
  "identifier": "app.residual.deduction",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "残局推演 · 解说视频生产线",
        "width": 1380,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../libs/large.onnx": "../libs/large.onnx",
      "../libs/ffmpeg/ffmpeg.exe": "../libs/ffmpeg/ffmpeg.exe",
      "../libs/pikafish/pikafish-windows.exe": "../libs/pikafish/pikafish-windows.exe",
      "../libs/pikafish/pikafish.nnue": "../libs/pikafish/pikafish.nnue",
      "../libs/windows-cpu/*.dll": "./"
    }
  }
}
